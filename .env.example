# Datadog Configuration
# Get your API key from https://app.datadoghq.com/organization-settings/api-keys
DD_API_KEY=your_datadog_api_key_here

# Datadog Site (use datadoghq.com for US1, datadoghq.eu for EU, etc.)
DD_SITE=datadoghq.com

# Environment tag for separating dev/staging/prod
DD_ENV=development

# Service name for APM
DD_SERVICE=govsearch

# Enable APM traces
DD_APM_ENABLED=true

# Enable profiling
DD_PROFILING_ENABLED=true

# Log level for Datadog agent
DD_LOG_LEVEL=INFO

# OpenSearch Configuration
OPENSEARCH_HOST=opensearch
OPENSEARCH_PORT=9200
OPENSEARCH_INDEX=govsites
SEEDS_FILE=/app/seeds.csv
